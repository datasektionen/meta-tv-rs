# Development image with hot reloading.
#
# This image only contains the toolchain. The source code is bind-mounted into
# /app by compose.yml, and the frontend and backend are rebuilt inside the
# container whenever a file changes (see dev-entrypoint.sh).

FROM rust:1.89-alpine

RUN apk update && apk upgrade && apk add make alpine-sdk libffi-dev trunk gcompat build-base nginx watchexec

ARG BUILDPLATFORM

RUN case "$BUILDPLATFORM" in \
    "linux/amd64")   wget -O TAILWIND_CSS https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64-musl;; \
    "linux/arm64")   wget -O TAILWIND_CSS https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-arm64-musl;; \
    *)               exit 1;; \
    esac

RUN chmod +x TAILWIND_CSS
RUN mv TAILWIND_CSS /usr/bin/tailwindcss
RUN tailwindcss --help

RUN rustup target add wasm32-unknown-unknown

WORKDIR /app

CMD ["sh", "./dev-entrypoint.sh"]
